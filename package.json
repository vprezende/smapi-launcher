{
  "name": "smapi-launcher",
  "version": "1.0.3",
  "description": "A fast CLI tool to create silent launchers and apply essential patches for SMAPI (Stardew Valley).",
  "keywords": [
    "stardew-valley",
    "smapi",
    "launcher",
    "mods",
    "patch",
    "unpatch",
    "garbage-collector",
    "multiplayer",
    "silent-launcher",
    "cli"
  ],
  "homepage": "https://github.com/vprezende/smapi-launcher",
  "bugs": {
    "url": "https://github.com/vprezende/smapi-launcher/issues"
  },
  "license": "MIT",
  "author": "Vinicius Rezende",
  "type": "module",
  "files": [
    "core/src/cli",
    "core/src/bin",
    "core/src/utils"
  ],
  "bin": "core/src/cli/main.js",
  "exports": {
    "./utils/*": "./core/src/utils/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vprezende/smapi-launcher.git"
  },
  "scripts": {
    "smapi-launcher": "node core/src/cli/main.js",
    "build": "node core/src/scripts/build/main.js",
    "sync": "node core/src/scripts/sync/main.js",
    "oidc": "node core/src/scripts/oidc/main.js",
    "clean:cargo": "rm -rf core/target core/Cargo.lock",
    "clean": "yarn clean:cargo && rm -rf core/src/bin"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "ansis": "^4.3.1",
    "node-emoji": "^2.2.0",
    "picocolors": "^1.1.1"
  },
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  }
}
